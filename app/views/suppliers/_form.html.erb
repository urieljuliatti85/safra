<%# locals: supplier %>
<%= form_with model: supplier, class: "panel grid max-w-xl gap-4 p-5", data: { turbo: false } do |form| %>
  <%= render "catalog/errors", record: supplier %>
  <div>
    <%= form.label :name, "Nome do fornecedor", class: "mb-1 block font-bold" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "field w-full" %>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.button type: "submit", class: "btn btn-primary" do %><%= icon :check %>Salvar<% end %>
    <%= link_to "Cancelar", suppliers_path, class: "btn" %>
  </div>
<% end %>
