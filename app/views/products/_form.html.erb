<%# locals: product, raw_materials, cuts %>
<%= form_with model: product, class: "panel grid max-w-xl gap-4 p-5", data: { turbo: false } do |form| %>
  <%= render "catalog/errors", record: product %>
  <div>
    <%= form.label :name, "Nome", class: "mb-1 block font-bold" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "field w-full" %>
  </div>
  <div>
    <%= form.label :product_group, "Grupo", class: "mb-1 block font-bold" %>
    <%= form.select :product_group, Product::GROUPS.map { |g| [ Product::GROUP_LABELS[g], g ] }, {}, class: "field w-full" %>
    <p class="muted mt-1 text-sm">Processado e fruta precisam de corte. In natura é a própria matéria-prima e não tem corte.</p>
  </div>
  <div>
    <%= form.label :raw_material_id, "Matéria-prima", class: "mb-1 block font-bold" %>
    <%= form.collection_select :raw_material_id, raw_materials, :id, :name, { prompt: "Escolha a matéria-prima" }, required: true, class: "field w-full" %>
  </div>
  <div>
    <%= form.label :cut_id, "Corte", class: "mb-1 block font-bold" %>
    <%= form.collection_select :cut_id, cuts, :id, :name, { include_blank: "Sem corte (só in natura)" }, class: "field w-full" %>
  </div>
  <div>
    <%= form.label :unit, "Unidade do produto", class: "mb-1 block font-bold" %>
    <%= form.select :unit, OrderLine::UNITS, {}, class: "field w-full" %>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <%= form.button type: "submit", class: "btn btn-primary" do %><%= icon :check %>Salvar<% end %>
    <%= link_to "Cancelar", products_path, class: "btn" %>
  </div>
<% end %>
