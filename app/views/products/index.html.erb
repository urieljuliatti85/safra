<% content_for :title, "Produtos · Safra" %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Cadastros</h1>
    <p class="page-sub">O que se vende: processado (matéria-prima + corte), fruta descascada ou embalada e in natura.</p>
  </div>
  <%= link_to new_product_path, class: "btn btn-primary" do %><%= icon :plus %>Novo produto<% end %>
</div>
<%= render "catalog/tabs" %>

<div class="mb-4 flex flex-wrap items-center gap-3">
  <nav class="chips" aria-label="Grupo">
    <%= link_to "Todos", products_path(q: @query.presence), class: "chip", "aria-current": (@group.nil? ? "true" : nil) %>
    <% Product::GROUPS.each do |group| %>
      <%= link_to Product::GROUP_LABELS[group], products_path(group: group, q: @query.presence), class: "chip", "aria-current": (@group == group ? "true" : nil) %>
    <% end %>
  </nav>
  <%= form_with url: products_path, method: :get, class: "ml-auto flex items-center gap-2", data: { turbo: false } do %>
    <%= hidden_field_tag :group, @group if @group %>
    <%= label_tag :q, "Buscar", class: "sr-only" %>
    <%= search_field_tag :q, @query, placeholder: "Buscar produto", class: "field" %>
    <%= button_tag "Buscar", type: "submit", class: "btn" %>
  <% end %>
</div>

<section class="panel">
  <div class="overflow-x-auto">
    <table class="ops-table" style="min-width: 40rem; table-layout: auto">
      <thead><tr><th>Produto</th><th>Grupo</th><th>Matéria-prima</th><th>Corte</th><th>Un.</th><th></th></tr></thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td class="name"><strong><%= product.name %></strong></td>
            <td><%= Product::GROUP_LABELS[product.product_group] %></td>
            <td><%= product.raw_material.name %></td>
            <td><%= product.cut&.name || "-" %></td>
            <td><%= product.unit %></td>
            <td class="whitespace-nowrap text-right">
              <%= link_to "Editar", edit_product_path(product), class: "btn" %>
              <%= button_to "Excluir", product_path(product), method: :delete, class: "btn", form: { class: "inline", data: { turbo_confirm: "Excluir #{product.name}?" } } %>
            </td>
          </tr>
        <% end %>
        <% if @products.empty? %><tr><td colspan="6" class="muted p-6 text-center">Nenhum produto encontrado.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</section>
