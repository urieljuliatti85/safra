<% content_for :title, "Estoque · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Estoque da câmara fria</h1>
    <p class="page-sub">O produto pronto que sobrou na câmara fria (excedente da produção), na unidade do produto: só o <strong>aproveitável</strong>, dentro da condição de uso e ainda não separado para um cliente. <strong>Campo vazio</strong> é não contado, <strong>0</strong> é nada aproveitável. A compra da CEASA não abate o estoque.</p>
  </div>
  <%= day_nav(@date, :stock_path) %>
</div>

<% if @errors.present? %>
  <div class="flash flash-alert" role="alert">
    <%= icon :alert %>
    <div><p class="font-bold">Nada foi salvo. Corrija:</p><ul class="list-disc ml-5"><% @errors.each do |error| %><li><%= error %></li><% end %></ul></div>
  </div>
<% end %>

<div class="mb-4 flex flex-wrap items-center gap-3">
  <%= form_with url: stock_path, method: :get, class: "search-form ml-auto flex flex-wrap items-center gap-2", data: { turbo: false } do %>
    <%= hidden_field_tag :date, @date.iso8601 %>
    <%= label_tag :q, "Buscar", class: "sr-only" %>
    <%= search_field_tag :q, @query, placeholder: "Buscar produto", class: "field" %>
    <% if purchase_visible? %><label class="flex items-center gap-2"><%= check_box_tag :todas, "1", @all, class: "size-5" %>Mostrar todas (<%= @total %>)</label><% end %>
    <%= button_tag "Filtrar", type: "submit", class: "btn" %>
  <% end %>
</div>

<%= form_with url: stock_path, method: :patch, data: { turbo: false } do %>
  <%= hidden_field_tag :date, @date.iso8601 %>
  <%= hidden_field_tag :q, @query if @query.present? %>
  <%= hidden_field_tag :todas, "1" if @all %>
  <h2 class="mb-2 text-lg font-bold">Produto pronto</h2>
  <div class="sheet-wrap">
    <table class="sheet stock-sheet ready-sheet">
      <thead>
        <tr>
          <th class="sticky-col">Produto</th>
          <th scope="col" class="px-2 text-right">Aproveitável em <%= short_date(@date) %></th>
          <th scope="col" class="px-2 text-right">Contagem anterior</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <% previous = @ready_previous[product.id] %>
          <tr>
            <th scope="row" class="sticky-col font-medium"><%= product.name %></th>
            <td class="count px-1 text-right"><%= text_field_tag "ready_counts[#{product.id}]", (qty(@ready_today[product.id].quantity) if @ready_today[product.id]), inputmode: "decimal", autocomplete: "off", class: "field w-24 text-right", "aria-label": "Contagem de #{product.name} pronto, em #{product.unit}" %><span class="unit-label ml-1 muted text-sm"><%= product.unit %></span></td>
            <td class="num px-2 text-right muted <%= 'is-empty' unless previous %>" data-label="Anterior"><%= previous ? "#{qty(previous.quantity)} #{product.unit} em #{short_date(previous.date)}" : "-" %></td>
          </tr>
        <% end %>
        <% if @products.empty? %>
          <tr><td colspan="3" class="muted p-6 text-center">Nenhum produto para mostrar. Marque "Mostrar todas" para contar qualquer um.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="savebar">
    <%= button_tag type: "submit", class: "btn btn-primary" do %><%= icon :check %>Salvar contagem<% end %>
    <span class="muted text-sm">Use vírgula para decimais. A lista mostra os produtos da próxima compra e os que já têm contagem.</span>
  </div>
<% end %>
