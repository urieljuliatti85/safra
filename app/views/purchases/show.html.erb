<% content_for :title, "Compras · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Compras CEASA</h1>
    <% if @date %>
      <% next_date = @purchase_dates.find { |d| d > @date } %>
      <p class="page-sub">Abastece a produção de <%= weekday_date(@date) %> até <%= next_date ? weekday_date(next_date - 1) : "o fim da semana" %>. O estoque da câmara fria é abatido antes.</p>
    <% end %>
  </div>
  <% if @date %>
    <%= link_to purchases_path(date: @date, format: :pdf), class: "btn", target: "_blank", rel: "noopener" do %><%= icon :printer %>PDF<% end %>
  <% end %>
</div>

<nav class="chips mb-4" aria-label="Dias de compra">
  <% @purchase_dates.each do |date| %>
    <%= link_to weekday_date(date), purchases_path(date: date), class: "chip num", "aria-current": (date == @date ? "true" : nil) %>
  <% end %>
</nav>

<% if @date.nil? %>
  <p class="panel p-8 text-center muted">Nenhum dia de compra cadastrado.</p>
<% else %>
  <div class="space-y-4">
    <%= render "shared/week", week: @week, open_date: @date, path: :purchases_path %>
    <%= render "shared/plan_status", plan: @latest_sent, changes: @changes, publish_path: publish_purchase_path(date: @date),
                                                 draft_text: "Ainda não enviada aos fornecedores", send_label: "Enviar aos fornecedores" %>

    <% @suppliers.each do |supplier, needs| %>
      <% text = ([ "*#{supplier} · compra #{short_date(@date)}*" ] + needs.map { |n| "#{n.raw_material.name}: #{need_text(n)}" }).join("\n") %>
      <section class="panel" data-controller="copy">
        <div class="panel-head">
          <h2><%= supplier %></h2>
          <button type="button" class="btn btn-primary" data-copy-target="button" data-action="copy#copy"><%= icon :copy %><span data-copy-target="label">Copiar para o WhatsApp</span></button>
        </div>
        <details class="border-b border-line-soft">
          <summary class="px-4 py-2 text-sm font-semibold muted">Ver o texto que será copiado</summary>
          <textarea data-copy-target="source" readonly rows="<%= needs.size + 1 %>" class="whatsapp" aria-label="Texto do pedido para <%= supplier %>"><%= text %></textarea>
        </details>
        <table class="ops-table">
          <thead><tr><th>Matéria-prima</th><th class="col-num only-desktop">Necessidade</th><th class="col-num only-desktop">Estoque</th><th class="col-qty">Comprar</th><th class="only-desktop">Observação</th></tr></thead>
          <tbody>
            <% needs.each do |need| %>
              <tr>
                <td class="name">
                  <details>
                    <summary><%= need.raw_material.name %></summary>
                    <ul class="mt-1 muted text-sm">
                      <% need.breakdown.each do |b| %><li><%= b.customer.short_name %>: <%= b.product.name %> <%= qty(b.quantity) %> <%= b.unit %> (entrega <%= short_date(b.delivery_date) %>, produção <%= short_date(b.production_date) %>)</li><% end %>
                    </ul>
                  </details>
                </td>
                <td class="num-col only-desktop"><%= qty(need.kg) %> <%= need.unit %></td>
                <td class="num-col only-desktop"><%= need.stock_kg.positive? ? "#{qty(need.stock_kg)} kg" : "-" %></td>
                <td class="qty"><%= need_text(need) %></td>
                <td class="note only-desktop"><% if need.missing_factor %>sem fator ou unidade diferente de kg<% elsif need.packages.nil? && need.unit == "kg" %>sem kg por embalagem<% end %></td>
                <td class="who only-mobile">necessidade <%= qty(need.kg) %> <%= need.unit %><%= " · estoque #{qty(need.stock_kg)} kg" if need.stock_kg.positive? %><% if need.missing_factor %> · sem fator ou unidade diferente de kg<% elsif need.packages.nil? && need.unit == "kg" %> · sem kg por embalagem<% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
    <% if @needs.empty? %><p class="panel p-8 text-center muted">Nada a comprar neste dia.</p><% end %>
  </div>
<% end %>
