<% content_for :title, "Produção · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Produção do dia</h1>
    <p class="page-sub">
      <% if @result.delivery_dates.any? %>Atende entregas de <%= @result.delivery_dates.map { |d| weekday_date(d) }.join(", ") %>.<% else %>Nenhuma entrega depende da produção deste dia.<% end %>
      <% if @date.sunday? %> Domingo não tem produção.<% end %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <%= day_nav(@date, :production_path, sector: @sector) %>
    <%= link_to production_path(date: @date, sector: @sector, format: :pdf), class: "btn", target: "_blank", rel: "noopener" do %><%= icon :printer %>PDF<% end %>
  </div>
</div>

<div class="space-y-4">
  <%= render "shared/week", week: @week, open_date: @date, path: :production_path %>
  <% if @draft %>
    <%= render "shared/plan_status", plan: @latest_sent, changes: @changes, publish_path: publish_production_path(date: @date),
                                                   draft_text: "Ainda não enviada aos setores", send_label: "Enviar aos setores", can_publish: policy(:production).publish? %>
  <% else %>
    <%= render "sent_status", plan: @latest_sent, date: @date, pending: @changes.any? %>
  <% end %>

  <% if @day.sectors.size > 1 %>
    <nav class="chips" aria-label="Setores">
      <%= link_to "Todos", production_path(date: @date), class: "chip", "aria-current": (@sector.nil? ? "true" : nil) %>
      <% @day.sectors.each do |sector| %>
        <%= link_to production_sector_label(@day, sector), production_path(date: @date, sector: sector), class: "chip",
                    "aria-current": (sector == @sector ? "true" : nil) %>
      <% end %>
    </nav>
  <% end %>

  <%= render "sectors", result: @result, changed_labels: @draft ? @changes.map(&:label) : @latest_sent&.changes_from_previous.to_a.map(&:label),
                       show_empty: @draft || @latest_sent %>
  <%= render "versions", versions: @versions if @versions.any? %>
  <%= render "alerts" if PushSender.enabled? %>
</div>
