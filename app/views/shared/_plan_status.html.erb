<%# locals: plan (última versão enviada ou nil), changes, publish_path, label %>
<section class="mb-5 rounded border bg-white p-3">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm"><strong><%= version_label(plan) %></strong></p>
    <% if plan.nil? || changes.any? %>
      <%= button_to (plan ? "Enviar nova versão (v#{plan.version + 1})" : "Enviar aos setores"), publish_path, method: :post,
            class: "rounded bg-green-700 px-3 py-2 font-semibold text-white hover:bg-green-800" %>
    <% else %>
      <span class="text-sm text-green-800">Igual ao que foi enviado.</span>
    <% end %>
  </div>
  <% if changes.any? %>
    <div class="mt-3 rounded bg-amber-50 border border-amber-300 p-3" role="alert">
      <p class="font-semibold text-amber-900">Mudou depois do envio (<%= changes.size %> <%= changes.size == 1 ? "item" : "itens" %>):</p>
      <ul class="mt-1 list-disc ml-5 text-sm">
        <% changes.each do |change| %><li><strong><%= change.label %></strong>: <%= change_text(change) %></li><% end %>
      </ul>
    </div>
  <% end %>
</section>
