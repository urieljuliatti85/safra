<%# locals: plan (última versão enviada ou nil), changes, publish_path, draft_text, send_label, can_publish,
    confirm (opcional: pede confirmação antes de enviar, ex. produção vazia) %>
<section class="panel" aria-label="Estado do envio">
  <div class="status">
    <% if plan %>
      <span class="pill pill-sent"><%= icon :check %>v<%= plan.version %> enviada</span>
      <span class="muted num"><%= l(plan.sent_at, format: "%d/%m às %H:%M") %></span>
    <% else %>
      <span class="pill pill-draft">Rascunho</span>
      <span class="muted"><%= draft_text %></span>
    <% end %>
    <% if can_publish && (plan.nil? || changes.any?) %>
      <% confirm = local_assigns[:confirm] %>
      <%= button_to publish_path, method: :post, class: "btn btn-primary push", params: (confirm ? { empty: 1 } : {}),
                                  form: { class: "push", data: { turbo_confirm: confirm }.compact } do %>
        <%= icon :send %><%= plan ? "Enviar versão #{plan.version + 1}" : send_label %>
      <% end %>
    <% elsif plan && changes.empty? %>
      <span class="push muted">Igual ao que foi enviado.</span>
    <% end %>
  </div>
  <% if changes.any? %>
    <div class="change-box" role="alert">
      <%= icon :alert %>
      <div>
        <p class="font-bold">Mudou depois do envio (<%= changes.size %> <%= changes.size == 1 ? "item" : "itens" %>)</p>
        <ul>
          <% changes.each do |change| %><li><strong><%= change.label %></strong>: <%= change_text(change) %></li><% end %>
        </ul>
      </div>
    </div>
  <% end %>
</section>
