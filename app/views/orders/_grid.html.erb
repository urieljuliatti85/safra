<%# locals: grid (OrderGrid), form_url, add_url, add_hidden (hash de campos ocultos do formulário de adicionar produto),
    extra (true: grade do extra, células vazias para o acréscimo), total_url e extra_url (os dois modos da grade),
    selected_type (tipo já escolhido: "new" ou "alteration"), cancel_url (ação "Cancelar item", R1.38, D23),
    focus_date (dia de entrega escolhido na tela "Importar": a grade abre nele). %>
<%# Tipo de pedido (R1.29 a R1.33, D22): quem lança escolhe; o sistema não decide sozinho. Pedido novo e alteração
    digitam o total; o extra digita só o acréscimo, e o sistema soma. %>
<% extra = local_assigns[:extra] %>
<% selected_type = local_assigns[:selected_type] %>
<%# No celular a grade mostra um dia de entrega por vez (sem rolar para o lado), com filtro "Só com pedido".
    Os outros dias continuam no formulário, escondidos, e são salvos juntos. %>
<%# "Adicionar linha" inclui o produto na grade sem recarregar (order-lines): dá para adicionar vários e salvar uma vez só,
    numa versão só. Sem JavaScript, o formulário de baixo continua abrindo a grade com o produto (?add=). %>
<div data-controller="order-lines">
<% focus_date = local_assigns[:focus_date] %>
<% cancel_url = local_assigns[:cancel_url] %>
<% start_day = (focus_date && grid.dates.index(focus_date)) || grid.dates.index(Date.current) || grid.dates.index { |date| grid.cells.values.flatten.any? { |line| line.delivery_date == date } } || 0 %>
<%= form_with url: form_url, method: :patch, data: { turbo: false, controller: "order-day#{' extra-sum' if extra}", order_day_index_value: start_day,
                                                     action: "input->order-day#count order-lines:added->order-day#showAll order-lines:removed->order-day#render#{' input->extra-sum#update' if extra}" } do %>
  <div class="only-mobile mb-3">
    <%# Um dia por vez, com setas, como a troca de semana: "Segunda 09/11 · 1 item". %>
    <div class="day-step" role="group" aria-label="Dia de entrega">
      <button type="button" class="icon-btn" data-order-day-target="previous" data-action="order-day#previous" aria-label="Dia anterior"><%= icon :chevron_left %></button>
      <p class="day-current" aria-live="polite">
        <% grid.dates.each_with_index do |date, index| %>
          <span class="day-label <%= 'is-sunday' if date.sunday? %>" data-order-day-target="day" hidden>
            <strong><%= Formatting::WEEKDAY_NAMES[date.wday] %> <span class="num"><%= date.strftime("%d/%m") %></span></strong>
            <span class="day-count num"> · <span data-order-day-target="count"></span></span>
          </span>
        <% end %>
      </p>
      <button type="button" class="icon-btn" data-order-day-target="next" data-action="order-day#next" aria-label="Próximo dia"><%= icon :chevron_right %></button>
    </div>
    <div class="chips mt-2" role="group" aria-label="Produtos">
      <button type="button" class="chip" data-order-day-target="filter" data-action="order-day#showAll">Todos</button>
      <button type="button" class="chip" data-order-day-target="filter" data-action="order-day#showFilled">Só com pedido</button>
    </div>
    <ul class="mt-2 space-y-1 text-sm muted">
      <li><strong>Todos</strong>: todos os produtos do cliente, para digitar um item novo no dia.</li>
      <li><strong>Só com pedido</strong>: só os produtos com quantidade no dia escolhido, para conferir.</li>
    </ul>
  </div>
  <div class="sheet-wrap">
    <table class="sheet order-sheet">
      <thead>
        <tr>
          <th class="sticky-col">Produto</th>
          <th scope="col">Un.</th>
          <% grid.dates.each_with_index do |date, index| %>
            <% classes = [ ("is-today" if date == Date.current), ("is-sunday" if date.sunday?), ("is-focus" if date == focus_date) ].compact.join(" ") %>
            <th scope="col" class="day <%= classes %>" data-col="<%= index %>"><span class="block"><%= Formatting::WEEKDAYS[date.wday] %></span><span class="num"><%= date.strftime("%d/%m") %></span></th>
          <% end %>
          <th scope="col" class="text-right pr-3">Total</th>
        </tr>
      </thead>
      <% Product::GROUPS.each do |group| %>
        <% rows = grid.sections[group] %>
        <% next if rows.blank? %>
        <tbody data-order-day-target="group" data-order-lines-group="<%= group %>">
          <tr><th colspan="<%= grid.dates.size + 3 %>" class="group" scope="colgroup"><%= Product::GROUP_LABELS[group] %></th></tr>
          <% rows.each do |product, unit| %>
            <% lines = grid.cells[[product.id, unit]] || [] %>
            <% by_date = lines.group_by(&:delivery_date).transform_values { |ls| ls.sum(&:quantity) } %>
            <tr data-order-day-target="row" data-order-lines-key="<%= product.id %>|<%= unit %>" data-order-lines-name="<%= product.name %>">
              <th scope="row" class="sticky-col font-medium">
                <%= product.name %>
                <% note = lines.map(&:note).compact.first %>
                <% if note %><span class="line-note is-clamped" title="Observação do pedido: <%= note %>"><%= icon :note %><span><span class="sr-only">Observação: </span><%= note %></span></span><% end %>
                <%# Medida pedida (R1.14, D12): orienta o preparo; sem ela, vale a referência do corte. %>
                <input type="text" autocomplete="off" maxlength="100" class="line-measure"
                       name="measures[<%= product.id %>|<%= unit %>]" value="<%= lines.map(&:measure).compact.first %>"
                       placeholder="<%= product.cut&.reference_measure.presence || 'medida pedida' %>"
                       aria-label="Medida pedida de <%= product.name %>">
                <%# "Cancelar item" (R1.38, D23): vazio ou 0 não tira item que já estava. Abrir e marcar o dia é o primeiro
                    passo; "Confirmar cancelamento" é a confirmação. Os campos são do formulário cancel-items, fora da grade. %>
                <% if cancel_url && !extra && by_date.any? %>
                  <% row_key = "#{product.id}|#{unit}" %>
                  <details class="cancel-item">
                    <summary>Cancelar item</summary>
                    <div class="cancel-item-body">
                      <p>Marque o dia e confirme. O item sai do pedido e a versão registra "cancelado".</p>
                      <% by_date.sort.each do |date, quantity| %>
                        <label><input type="checkbox" form="cancel-items-form" name="cancel[]" value="<%= row_key %>|<%= date.iso8601 %>" class="size-4">
                          <%= Formatting::WEEKDAYS[date.wday] %> <%= date.strftime("%d/%m") %> · <%= qty(quantity) %> <%= unit %></label>
                      <% end %>
                      <% if by_date.keys.any? { |date| grid.late_dates.include?(date) } %>
                        <label><input type="checkbox" form="cancel-items-form" name="late_confirmed[<%= row_key %>]" value="1" class="size-4">
                          <%= current_company.name %> confirmou (menos de 48 h da entrega)</label>
                      <% end %>
                      <button type="submit" form="cancel-items-form" name="row" value="<%= row_key %>" class="btn">Confirmar cancelamento</button>
                    </div>
                  </details>
                <% end %>
              </th>
              <td class="unit"><%= unit %></td>
              <% grid.dates.each_with_index do |date, index| %>
                <td class="<%= 'is-sunday' if date.sunday? %>" data-col="<%= index %>">
                  <% if extra %>
                    <%# "tem X" no placeholder, como no celular. No computador a célula do extra é mais larga, para o número
                        caber inteiro, e a frase toda fica no title, ao passar o mouse. %>
                    <% has = by_date[date] && "Já tem #{qty(by_date[date])} #{unit} no pedido. Digite só o acréscimo." %>
                    <input type="text" inputmode="decimal" autocomplete="off" class="cell cell-extra" placeholder="<%= by_date[date] ? "tem #{qty(by_date[date])}" : '·' %>"
                           name="quantities[<%= product.id %>|<%= unit %>][<%= date.iso8601 %>]" title="<%= has %>" data-current="<%= by_date[date]&.to_s("F") %>"
                           aria-label="Acréscimo de <%= product.name %> em <%= weekday_date(date) %><%= ", já tem #{qty(by_date[date])}" if by_date[date] %>">
                    <%# Atual + acréscimo = total, enquanto se digita (R1.37, D23). %>
                    <span class="extra-sum num" aria-live="polite"></span>
                  <% else %>
                    <input type="text" inputmode="decimal" autocomplete="off" class="cell" placeholder="·"
                           name="quantities[<%= product.id %>|<%= unit %>][<%= date.iso8601 %>]"
                           value="<%= qty(by_date[date]) if by_date[date] %>"
                           aria-label="<%= product.name %> em <%= weekday_date(date) %>">
                  <% end %>
                </td>
              <% end %>
              <td class="total num"><%= qty(by_date.values.sum) %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
      <% if grid.rows.empty? %>
        <tbody data-order-lines-target="empty"><tr><td colspan="<%= grid.dates.size + 3 %>" class="p-8 text-center muted">Nenhum produto nesta semana. Adicione uma linha abaixo.</td></tr></tbody>
      <% end %>
    </table>
    <p class="only-mobile off-filter p-6 text-center muted" data-order-day-target="empty">Nenhum produto com pedido neste dia. Toque em Todos para digitar.</p>
  </div>
  <div class="savebar">
    <% if extra %>
      <%= hidden_field_tag :entry_type, "extra" %>
      <%= button_tag type: "submit", class: "btn btn-primary" do %><%= icon :check %>Somar extra ao pedido<% end %>
      <span class="muted text-sm">Extra: digite só o acréscimo; o sistema soma ao que já está no pedido. Vazio não muda nada. Use vírgula para decimais.</span>
      <%= render "orders/entry_type_help" %>
      <% if local_assigns[:total_url] %><%= link_to "Voltar à grade do pedido", total_url, class: "btn" %><% end %>
    <% else %>
      <fieldset class="flex flex-wrap items-center gap-3 text-sm">
        <legend class="sr-only">Tipo de pedido</legend>
        <span class="font-bold">Tipo:</span>
        <% { "new" => "Pedido novo", "alteration" => "Alteração (novo total)" }.each do |value, label| %>
          <label class="flex items-center gap-1"><%= radio_button_tag :entry_type, value, selected_type == value, required: true, class: "size-4" %><%= label %></label>
        <% end %>
        <% if local_assigns[:extra_url] %><%= link_to "Lançar extra (soma)", extra_url, class: "btn" %><% end %>
        <%= render "orders/entry_type_help" %>
      </fieldset>
      <%= button_tag type: "submit", class: "btn btn-primary" do %><%= icon :check %>Salvar pedido<% end %>
      <%= render "orders/late_confirmation", items: grid.late_dates.map { |date| short_date(date) }, intro: "Mudar ou cancelar quantidade a menos de 48 h da entrega pede a confirmação. Dias:" %>
      <span class="muted text-sm">Vazio ou 0 não tira item do pedido: use "Cancelar item" na linha. Use vírgula para decimais.</span>
    <% end %>
  </div>
<% end %>

<% if cancel_url %><%= form_with url: cancel_url, method: :patch, id: "cancel-items-form", data: { turbo: false } do %><% end %><% end %>

<%= form_with url: add_url, method: :get, class: "relative mt-8 flex flex-wrap items-end gap-3", data: { turbo: false, action: "submit->order-lines#add" } do %>
  <% add_hidden.each do |name, value| %><%= hidden_field_tag name, value %><% end %>
  <div>
    <label for="add" class="mb-1 block text-sm font-bold">Adicionar produto</label>
    <select id="add" name="add" class="field" data-order-lines-target="select">
      <% grid.available_products.group_by(&:product_group).each do |group, products| %>
        <optgroup label="<%= Product::GROUP_LABELS[group] %>">
          <% products.each do |product| %><option value="<%= product.id %>" data-group="<%= product.product_group %>" data-name="<%= product.name %>" data-unit="<%= product.unit %>"
                    data-measure="<%= product.cut&.reference_measure.presence || 'medida pedida' %>"><%= product.name %> (<%= product.unit %>)</option><% end %>
        </optgroup>
      <% end %>
    </select>
  </div>
  <%= button_tag type: "submit", class: "btn" do %><%= icon :plus %>Adicionar linha<% end %>
  <%= render "orders/help_tip", label: "Como funciona?" do %>
    <p>A linha nova aparece vazia na grade. Dá para adicionar vários produtos, preencher as quantidades e salvar uma vez só: o pedido ganha uma versão só. Sem quantidade, a linha some ao salvar.</p>
  <% end %>
<% end %>

<%# Modelos da linha nova e do grupo que ainda não está na grade. __KEY__, __NAME__, __UNIT__ e __MEASURE__ são trocados pelo
    produto escolhido, já escapados (order_lines_controller.js). %>
<% Product::GROUPS.each do |group| %>
  <template data-order-lines-target="groupTemplate" data-group="<%= group %>">
    <tbody data-order-day-target="group" data-order-lines-group="<%= group %>">
      <tr><th colspan="<%= grid.dates.size + 3 %>" class="group" scope="colgroup"><%= Product::GROUP_LABELS[group] %></th></tr>
    </tbody>
  </template>
<% end %>
<template data-order-lines-target="rowTemplate">
  <tr data-order-day-target="row" data-order-lines-key="__KEY__" data-order-lines-name="__NAME__" class="is-new-line">
    <th scope="row" class="sticky-col font-medium">
      __NAME__ <span class="new-line-tag">nova</span>
      <input type="text" autocomplete="off" maxlength="100" class="line-measure" name="measures[__KEY__]" placeholder="__MEASURE__"
             aria-label="Medida pedida de __NAME__">
      <button type="button" class="new-line-remove" data-action="order-lines#remove" aria-label="Remover __NAME__">Remover</button>
    </th>
    <td class="unit">__UNIT__</td>
    <% grid.dates.each_with_index do |date, index| %>
      <td class="<%= 'is-sunday' if date.sunday? %>" data-col="<%= index %>">
        <input type="text" inputmode="decimal" autocomplete="off" class="cell<%= ' cell-extra' if extra %>" placeholder="·"
               name="quantities[__KEY__][<%= date.iso8601 %>]"
               aria-label="<%= 'Acréscimo de ' if extra %>__NAME__ em <%= weekday_date(date) %>">
        <% if extra %><span class="extra-sum num" aria-live="polite"></span><% end %>
      </td>
    <% end %>
    <td class="total num">0</td>
  </tr>
</template>
</div>
