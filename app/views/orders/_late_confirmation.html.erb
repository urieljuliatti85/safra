<%# A caixa das 48 h só aparece quando vale (R1.26, D8): mudar ou cancelar quantidade que já estava no pedido a menos de 48 h da entrega. %>
<%# items: o que pede a confirmação ("Cenoura ralada em 14/10"), ou os dias, na grade. %>
<% if items.any? %>
  <label class="flex items-center gap-2 text-sm"><%= check_box_tag :late_confirmed, "1", false, class: "size-5" %><%= current_company.name %> confirmou a alteração (menos de 48 h da entrega)</label>
  <span class="muted text-sm"><%= intro %> <%= items.to_sentence %>.</span>
<% end %>
