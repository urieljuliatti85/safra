<% content_for :title, "Pedidos · Safra" %>
<%# No celular o cliente é um select acima do título; no computador, pílulas abaixo dele. %>
<nav class="only-mobile mb-3" aria-label="Clientes">
  <%= form_with url: orders_path, method: :get, data: { controller: "autosubmit" } do %>
    <%= hidden_field_tag :week, @week_start %>
    <%= label_tag :customer, "Escolha o cliente:", class: "mb-1 block text-sm font-semibold muted" %>
    <%= select_tag :customer, options_for_select(@customers.map { |c| [ c.short_name, c.code ] }, @customer.code),
                   class: "field customer-select", data: { action: "autosubmit#submit" } %>
  <% end %>
</nav>

<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Pedidos de <%= @customer.name %></h1>
    <p class="page-sub"><strong>Origem do pedido</strong> · <%= @customer.order_source %>. Só o pedido é digitado: programação, produção e compras são calculadas.</p>
  </div>
  <div class="flex w-full flex-col gap-2 sm:w-auto">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to new_order_import_path(customer: @customer.code), class: "btn", data: { tour: "import" } do %><%= icon :plus %>Importar planilha<% end %>
      <%= link_to "#versoes", class: "btn", "aria-label": "Versões desta semana" do %><%= icon :history %>Versões<% if @versions.any? %> <span class="pill pill-draft num">v<%= @versions.first.version %></span><% end %><% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to icon(:chevron_left), orders_path(customer: @customer.code, week: @week_start - 7), class: "icon-btn", "aria-label": "Semana anterior" %>
      <strong class="num min-w-36 flex-1 text-center sm:flex-none">Semana de <%= short_date(@week_start) %></strong>
      <%= link_to icon(:chevron_right), orders_path(customer: @customer.code, week: @week_start + 7), class: "icon-btn", "aria-label": "Próxima semana" %>
    </div>
  </div>
</div>

<nav class="chips only-desktop mb-4" aria-label="Clientes">
  <% @customers.each do |customer| %>
    <%= link_to customer.short_name, orders_path(customer: customer.code, week: @week_start), class: "chip", "aria-current": (customer == @customer ? "true" : nil) %>
  <% end %>
</nav>

<% if @imports.present? %>
  <div class="mb-4 flex flex-wrap items-center gap-2" aria-label="Planilhas importadas nesta semana">
    <span class="text-sm muted">Importado nesta semana:</span>
    <% @imports.each do |import| %>
      <%= link_to order_import_path(import, anchor: "desfazer"), class: "pill pill-undo", title: "Abrir #{import.filename} para conferir ou desfazer" do %>
        <%= icon :undo %>Desfazer <span class="font-normal"><%= import.filename %> · <%= l(import.applied_at, format: "%d/%m %H:%M") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @copy_count.positive? %>
  <div class="flash flash-notice mb-4 flex flex-wrap items-center justify-between gap-3" aria-label="Copiar pedido da semana anterior">
    <p><%= icon :copy %> Esta semana ainda não tem pedido. A semana de <%= short_date(@week_start - 7) %> tem <%= pluralize(@copy_count, "item", plural: "itens") %>: copie e ajuste só o que mudou.</p>
    <%= button_to copy_previous_orders_path(customer: @customer.code, week: @week_start), class: "btn", form: { class: "inline" } do %><%= icon :copy %>Copiar semana anterior<% end %>
  </div>
<% end %>

<% if @errors.present? %>
  <div class="flash flash-alert" role="alert">
    <%= icon :alert %>
    <div>
      <p class="font-bold">Nada foi salvo. Corrija estas células:</p>
      <ul class="list-disc ml-5"><% @errors.each do |error| %><li><%= error %></li><% end %></ul>
    </div>
  </div>
<% end %>

<%= render "orders/grid", grid: @grid, form_url: orders_path(customer: @customer.code, week: @week_start),
                       add_url: orders_path, add_hidden: { customer: @customer.code, week: @week_start } %>

<%= render "orders/versions", versions: @versions %>
