<% content_for :title, "Pedidos · Safra" %>
<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Pedidos de <%= @customer.name %></h1>
    <p class="page-sub"><strong>Origem do pedido</strong> · <%= @customer.order_source %>. Só o pedido é digitado: programação, produção e compras são calculadas.</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to new_order_import_path(customer: @customer.code), class: "btn" do %><%= icon :plus %>Importar planilha<% end %>
    <%= link_to icon(:chevron_left), orders_path(customer: @customer.code, week: @week_start - 7), class: "icon-btn", "aria-label": "Semana anterior" %>
    <strong class="num min-w-36 text-center">Semana de <%= short_date(@week_start) %></strong>
    <%= link_to icon(:chevron_right), orders_path(customer: @customer.code, week: @week_start + 7), class: "icon-btn", "aria-label": "Próxima semana" %>
  </div>
</div>

<nav class="chips mb-4" aria-label="Clientes">
  <% @customers.each do |customer| %>
    <%= link_to customer.short_name, orders_path(customer: customer.code, week: @week_start), class: "chip", "aria-current": (customer == @customer ? "true" : nil) %>
  <% end %>
</nav>

<% if @errors.present? %>
  <div class="flash flash-alert" role="alert">
    <%= icon :alert %>
    <div>
      <p class="font-bold">Nada foi salvo. Corrija estas células:</p>
      <ul class="list-disc ml-5"><% @errors.each do |error| %><li><%= error %></li><% end %></ul>
    </div>
  </div>
<% end %>

<%= form_with url: orders_path(customer: @customer.code, week: @week_start), method: :patch, data: { turbo: false } do %>
  <div class="sheet-wrap">
    <table class="sheet">
      <thead>
        <tr>
          <th class="sticky-col">Produto</th>
          <th scope="col">Un.</th>
          <% @dates.each do |date| %>
            <% classes = [ ("is-today" if date == Date.current), ("is-sunday" if date.sunday?) ].compact.join(" ") %>
            <th scope="col" class="day <%= classes %>"><span class="block"><%= Formatting::WEEKDAYS[date.wday] %></span><span class="num"><%= date.strftime("%d/%m") %></span></th>
          <% end %>
          <th scope="col" class="text-right pr-3">Total</th>
        </tr>
      </thead>
      <% Product::GROUPS.each do |group| %>
        <% rows = @sections[group] %>
        <% next if rows.blank? %>
        <tbody>
          <tr><th colspan="<%= @dates.size + 3 %>" class="group" scope="colgroup"><%= Product::GROUP_LABELS[group] %></th></tr>
          <% rows.each do |product, unit| %>
            <% lines = @cells[[product.id, unit]] || [] %>
            <% by_date = lines.group_by(&:delivery_date).transform_values { |ls| ls.sum(&:quantity) } %>
            <tr>
              <th scope="row" class="sticky-col font-medium">
                <%= product.name %>
                <% note = lines.map(&:note).compact.first %>
                <% if note %><span class="tag-change" title="<%= note %>">obs.</span><% end %>
              </th>
              <td class="unit"><%= unit %></td>
              <% @dates.each do |date| %>
                <td class="<%= 'is-sunday' if date.sunday? %>">
                  <input type="text" inputmode="decimal" autocomplete="off" class="cell" placeholder="·"
                         name="quantities[<%= product.id %>|<%= unit %>][<%= date.iso8601 %>]"
                         value="<%= qty(by_date[date]) if by_date[date] %>"
                         aria-label="<%= product.name %> em <%= weekday_date(date) %>">
                </td>
              <% end %>
              <td class="total num"><%= qty(by_date.values.sum) %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
      <% if @rows.empty? %>
        <tbody><tr><td colspan="<%= @dates.size + 3 %>" class="p-8 text-center muted">Nenhum produto nesta semana. Adicione uma linha abaixo.</td></tr></tbody>
      <% end %>
    </table>
  </div>
  <div class="savebar">
    <%= button_tag type: "submit", class: "btn btn-primary" do %><%= icon :check %>Salvar pedido<% end %>
    <span class="muted text-sm">Quantidade vazia ou 0 apaga a linha. Use vírgula para decimais.</span>
  </div>
<% end %>

<%= form_with url: orders_path, method: :get, class: "mt-8 flex flex-wrap items-end gap-3", data: { turbo: false } do %>
  <%= hidden_field_tag :customer, @customer.code %>
  <%= hidden_field_tag :week, @week_start %>
  <div>
    <label for="add" class="mb-1 block text-sm font-bold">Adicionar produto</label>
    <select id="add" name="add" class="field">
      <% @available_products.group_by(&:product_group).each do |group, products| %>
        <optgroup label="<%= Product::GROUP_LABELS[group] %>">
          <% products.each do |product| %><option value="<%= product.id %>"><%= product.name %> (<%= product.unit %>)</option><% end %>
        </optgroup>
      <% end %>
    </select>
  </div>
  <%= button_tag type: "submit", class: "btn" do %><%= icon :plus %>Adicionar linha<% end %>
  <p class="basis-full muted text-sm">A linha nova aparece vazia. Preencha as quantidades e salve; sem quantidade, ela some.</p>
<% end %>
