<% content_for :title, "Programação · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Programação de entregas</h1>
    <p class="page-sub">O que cada cliente pediu para o dia e quando cada item é produzido.</p>
  </div>
  <div class="flex items-center gap-3">
    <%= day_nav(@date, :schedule_path) %>
    <%= link_to schedule_path(date: @date, format: :pdf), class: "btn", target: "_blank", rel: "noopener" do %><%= icon :printer %>PDF<% end %>
  </div>
</div>
<div class="space-y-4">
  <% if @groups.empty? %>
    <p class="panel p-8 text-center muted">Nenhuma entrega em <%= weekday_date(@date) %>.</p>
  <% end %>
  <% @groups.each do |group| %>
    <section class="panel">
      <div class="panel-head"><h2><%= group.customer.name %></h2><span class="meta num"><%= group.entries.size %> itens</span></div>
      <table class="ops-table">
        <thead><tr><th>Produto</th><th class="col-qty">Qtd.</th><th class="col-unit">Un.</th><th>Produzir em</th></tr></thead>
        <tbody>
          <% group.entries.each do |entry| %>
            <tr>
              <td class="name">
                <%= entry.product.name %>
                <% if entry.note %><span class="line-note"><%= icon :note %><span><span class="sr-only">Observação: </span><%= entry.note %></span></span><% end %>
              </td>
              <td class="qty" data-unit="<%= entry.unit %>"><%= qty(entry.quantity) %></td>
              <td class="unit"><%= entry.unit %></td>
              <td class="who"><%= entry.production_date ? weekday_date(entry.production_date) : "compra (in natura)" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>
