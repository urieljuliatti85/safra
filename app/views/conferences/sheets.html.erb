<% content_for :title, "Sistema × planilhas · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Sistema × planilhas</h1>
    <p class="page-sub">Os números das planilhas feitas à mão ao lado do que o Safra tem e calcula, com o motivo provável de cada diferença.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to new_reference_sheets_path(week: @week&.iso8601), class: "btn btn-primary" do %><%= icon :check %>Importar planilhas<% end %>
    <% if @comparison&.sheets&.any? %><%= link_to "PDF da semana", conference_sheets_path(week: @week.iso8601, format: :pdf), class: "btn", target: "_blank", rel: "noopener" %><% end %>
    <%= link_to conference_path, class: "btn" do %><%= icon :chevron_left %>Conferência<% end %>
  </div>
</div>

<% if @week.nil? %>
  <section class="panel p-5">
    <p class="font-bold">Nenhuma planilha importada ainda.</p>
    <p class="muted mt-1">Envie a 01 - Programação, a 02 - Planilha de produção e a 03 - Compras CEASA da semana para comparar.</p>
  </section>
<% else %>
  <% comparison = @comparison %>
  <nav class="chips mb-4" aria-label="Semanas importadas">
    <% @weeks.each do |week| %>
      <%= link_to "Semana de #{comparison_week_text(week)}", conference_sheets_path(week: week.iso8601), class: "chip num", "aria-current": (week == @week).to_s %>
    <% end %>
    <% unless @weeks.include?(@week) %><span class="chip num" aria-current="true">Semana de <%= comparison_week_text(@week) %></span><% end %>
  </nav>

  <% if comparison.sheets.empty? %>
    <section class="panel p-5"><p>Nenhuma planilha importada na semana de <%= comparison_week_text(@week) %>.</p></section>
  <% else %>
    <% scores = comparison.scores %>
    <% differences = comparison.reasons.sum { |_, n| n } %>
    <section class="panel mb-4 cmp-score" aria-label="Placar da semana">
      <div class="cmp-score-grid">
        <% SheetComparison::KINDS.each do |kind, title| %>
          <div>
            <p class="cmp-score-label"><%= title %></p>
            <% if scores[kind][1].zero? %>
              <p class="cmp-score-value cmp-score-empty">-<span>sem planilha</span></p>
            <% else %>
              <p class="cmp-score-value num"><%= scores[kind][0] %> <span>de <%= scores[kind][1] %> iguais</span></p>
            <% end %>
          </div>
        <% end %>
        <div>
          <p class="cmp-score-label">Diferenças com motivo</p>
          <p class="cmp-score-value num"><%= comparison.explained_count %> <span>de <%= differences %></span></p>
        </div>
      </div>
      <% if comparison.reasons.any? %>
        <ul class="cmp-reasons">
          <% comparison.reasons.each do |reason, count| %>
            <li class="<%= 'is-open' if reason == :unexplained %>"><span><%= SheetComparison::REASONS.fetch(reason) %></span><strong class="num"><%= count %></strong></li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <% if comparison.unmatched.any? %>
      <section class="panel mb-4" id="nomes">
        <div class="panel-head">
          <h2>Nomes que o Safra não reconheceu</h2>
          <span class="meta">Ligue uma vez e vale para as próximas semanas</span>
        </div>
        <ul class="cmp-unmatched">
          <% comparison.unmatched.each do |item| %>
            <li>
              <%= form_with url: sheet_aliases_path, class: "cmp-unmatched-form" do |f| %>
                <%= hidden_field_tag :target, item.target, id: nil %>
                <%= hidden_field_tag :label, item.label, id: nil %>
                <%= hidden_field_tag :week, @week.iso8601, id: nil %>
                <% field_id = "alias-#{item.target}-#{item.label.parameterize}" %>
                <label for="<%= field_id %>"><strong><%= item.label %></strong> <span class="muted text-sm">(<%= unmatched_where(item) %>)</span></label>
                <select id="<%= field_id %>" name="record_id" class="field" required>
                  <option value=""><%= SheetAlias::TARGET_PROMPTS.fetch(item.target).delete_suffix(".") %></option>
                  <% @choices.fetch(item.target).each do |record| %>
                    <option value="<%= record.id %>"><%= record.name %></option>
                  <% end %>
                  <option value="ignore">Não comparar este item</option>
                </select>
                <%= button_tag "Ligar", type: "submit", class: "btn" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div class="space-y-4">
      <% SheetComparison::KINDS.each do |kind, title| %>
        <% comparison.rows_for(kind).group_by(&:date).sort.each do |date, day_rows| %>
          <% equal = day_rows.select(&:ok?) %>
          <% extra = day_rows.select { |row| row.status == :only_system && row.reason == :not_in_sheet } %>
          <% open = day_rows - equal - extra %>
          <section class="panel" id="dia-<%= kind %>-<%= date.iso8601 %>">
            <div class="panel-head">
              <h2><%= title %> · <%= weekday_date(date) %></h2>
              <span class="meta num"><%= equal.size %> de <%= day_rows.count(&:scored?) %> iguais</span>
            </div>
            <% if open.any? %>
              <table class="ops-table cmp-table">
                <thead><tr><th>Item</th><th class="col-num">Planilha</th><th class="col-num">Safra</th><th>Situação e motivo</th></tr></thead>
                <% open.group_by(&:section).sort_by { |section, _| kind == :schedule ? section : 0 }.each do |section, section_rows| %>
                  <tbody>
                    <% unless kind == :purchase %><tr class="cmp-section"><th colspan="4" scope="rowgroup"><%= SheetComparison::SECTION_LABELS.fetch(section, section) %></th></tr><% end %>
                    <%= render partial: "conferences/comparison_row", collection: comparison_sorted(section_rows), as: :row %>
                  </tbody>
                <% end %>
              </table>
            <% else %>
              <p class="cmp-all-equal"><%= icon :check %>Nenhuma diferença neste dia.</p>
            <% end %>
            <% [ [ equal, "item igual", "itens iguais" ], [ extra, "item que só o Safra tem", "itens que só o Safra tem" ] ].each do |list, one, many| %>
              <% next if list.empty? %>
              <details class="cmp-extra">
                <summary><%= plural(list.size, one, many) %></summary>
                <table class="ops-table cmp-table">
                  <tbody><%= render partial: "conferences/comparison_row", collection: list.sort_by { |row| [ row.section, row.label ] }, as: :row, locals: { show_section: kind != :purchase } %></tbody>
                </table>
              </details>
            <% end %>
          </section>
        <% end %>
      <% end %>
    </div>

    <% if @imports.any? %>
      <section class="panel mt-4" id="historico">
        <div class="panel-head">
          <h2>Histórico de importações</h2>
          <span class="meta">Cada envio fica guardado; a comparação usa o mais recente de cada dia</span>
        </div>
        <ul class="cmp-imports">
          <% @imports.each do |import| %>
            <li>
              <p><%= link_to sheet_import_text(import), sheet_import_path(import), class: "font-bold underline" %>
                <span class="muted text-sm"><%= import.filenames.join(", ") %></span></p>
              <p class="muted text-sm">
                <%= safe_join(import.sorted_versions.map { |version| "#{sheet_title(version.reference_sheet)} v#{version.version}: #{version_summary(version)}" }, " · ") %>
              </p>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
<% end %>
