<% content_for :title, "Comparar com planilhas · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Sistema × planilhas</h1>
    <p class="page-sub">Dias 13 e 15/10/2026. Cada diferença é uma regra ainda não cadastrada ou um ajuste feito à mão (veja docs/duvidas.md).</p>
  </div>
  <%= link_to conference_path, class: "btn" do %><%= icon :chevron_left %>Conferência<% end %>
</div>
<div class="space-y-4">
  <% { "Produção" => @comparison.production_rows, "Compras CEASA" => @comparison.purchase_rows }.each do |title, rows| %>
    <% rows.group_by(&:date).each do |date, day_rows| %>
      <section class="panel">
        <div class="panel-head">
          <h2><%= title %> · <%= short_date(date) %></h2>
          <span class="meta num"><%= day_rows.count { |r| r.status == "ok" } %> de <%= day_rows.size %> iguais</span>
        </div>
        <table class="ops-table">
          <thead><tr><th>Item</th><th class="col-num">Planilha</th><th class="col-num">Sistema</th><th>Situação</th></tr></thead>
          <tbody>
            <% day_rows.sort_by { |r| [ r.status == "ok" ? 1 : 0, (r.try(:product) || r.raw_material).to_s ] }.each do |row| %>
              <tr class="<%= 'is-changed' unless row.status == 'ok' %>">
                <td class="name"><%= row.try(:product) || row.raw_material %></td>
                <td class="num-col"><%= row.try(:planilha_text) || (row.planilha ? qty(row.planilha) : "-") %></td>
                <td class="num-col"><%= row.sistema ? "#{qty(row.sistema)} #{row.try(:unit)}" : "-" %></td>
                <td class="who"><%= row.status %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  <% end %>
</div>
