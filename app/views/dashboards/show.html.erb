<% content_for :title, "Painel · Safra" %>
<% summary = @summary %>
<div class="dash-head">
  <h1 class="page-title">Painel</h1>
  <p class="dash-date">Hoje, <%= weekday_date(summary.date) %></p>
</div>

<% changed = summary.stale_production.map { |d| "produção de #{short_date(d)}" } + summary.stale_purchase.map { |d| "compra de #{short_date(d)}" } %>
<% if changed.any? %>
  <div class="flash flash-alert" role="status">
    <%= icon(:alert) %>
    <p><strong>Mudou depois do envio:</strong> <%= changed.to_sentence %>. Abra a etapa para ver a diferença e reenviar.</p>
  </div>
<% end %>

<ol class="flow" aria-label="Etapas do trabalho">
  <% summary.stages.each_with_index do |stage, index| %>
    <li class="flow-step" data-state="<%= stage.state %>">
      <div class="flow-head">
        <span class="flow-node" aria-hidden="true"><%= index + 1 %></span>
        <h2 class="flow-title" id="stage-<%= stage.key %>"><%= stage.title %></h2>
      </div>
      <p class="flow-status"><span class="sr-only">Etapa <%= index + 1 %>: </span><%= stage.status %></p>
      <% if stage.facts.any? %>
        <ul class="flow-facts"><% stage.facts.each do |fact| %><li><%= fact %></li><% end %></ul>
      <% end %>
      <% needs_action = %i[pending changed].include?(stage.state) %>
      <div class="flow-actions">
        <%= link_to stage.action_label, stage.action_path, class: needs_action ? "btn btn-primary" : "flow-link" %>
        <% if stage.secondary %><%= link_to stage.secondary[:label], stage.secondary[:path], class: "flow-link" %><% end %>
      </div>
    </li>
  <% end %>
</ol>

