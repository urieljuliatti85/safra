<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Safra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0c1810">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Safra">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preload" href="<%= asset_path("bricolage-grotesque-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= yield :body_class %>">
    <header class="shell-nav">
      <div class="shell-nav-inner">
        <%= link_to (authenticated? ? root_path : new_session_path), class: "brand", "aria-label": "Safra, início" do %><%= brand_mark %>Safra<% end %>
        <% if authenticated? %>
          <nav class="nav-links" aria-label="Principal">
            <%= nav_link "Painel", dashboard_path, "dashboards" if policy(:dashboard).show? %>
            <%= nav_link "Pedidos", orders_path, "orders" if policy(:order).index? %>
            <%= nav_link "Programação", schedule_path, "schedules" if policy(:schedule).show? %>
            <%= nav_link "Produção", production_path, "productions" if policy(:production).show? %>
            <%= nav_link "Compras", purchases_path, "purchases" if policy(:purchase).show? %>
            <%= nav_link "Estoque", stock_path, "stocks" if policy(:stock).show? %>
            <%= nav_link "BI", indicators_path, "indicators" if policy(:indicator).show? %>
            <%= nav_link "Conferência", conference_path, "conferences" if policy(:conference).show? %>
            <%= nav_link "Regras", rules_path, "rules" if policy(:rule).show? %>
            <%= nav_link "Cadastros", raw_materials_path, %w[raw_materials products customers suppliers customer_aliases cuts] if policy(:raw_material).index? %>
          </nav>
          <details class="user-menu">
            <summary><span class="user-name"><%= current_user.name %></span><span class="sr-only">Menu da conta</span><%= icon :chevron_right, class: "icon user-chevron" %></summary>
            <div class="user-menu-panel">
              <p class="muted text-sm"><%= current_user.role_label %> · <%= current_company.name %></p>
              <% if policy(:user).index? %><%= link_to "Usuários", users_path, class: "user-menu-item" %><% end %>
              <% if policy(:company).index? %><%= link_to "Empresas", companies_path, class: "user-menu-item" %><% end %>
              <% if policy(:api_token).index? %><%= link_to "Chaves de API", api_tokens_path, class: "user-menu-item" %><% end %>
              <% if policy(:audit_log).index? %><%= link_to "Histórico", audit_logs_path, class: "user-menu-item" %><% end %>
              <%= link_to "Trocar senha", edit_account_password_path, class: "user-menu-item" %>
              <%= button_to "Sair", session_path, method: :delete, class: "user-menu-item", form: { class: "contents" } %>
            </div>
          </details>
        <% end %>
      </div>
    </header>
    <main class="mx-auto <%= content_for?(:wide) ? 'max-w-[90rem]' : 'max-w-7xl' %> px-4 py-6">
      <% if notice %><p class="flash flash-notice" role="status"><%= icon :check %><span><%= notice %></span></p><% end %>
      <% if alert %><p class="flash flash-alert" role="alert"><%= icon :alert %><span><%= alert %></span></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
