<% content_for :title, "Importar planilha · Safra" %>
<div class="mb-5">
  <h1 class="page-title">Importar planilha de pedido</h1>
  <p class="page-sub">Envie a grade que o cliente mandou (xlsx, xls, ods ou csv). Você confere o que muda antes de gravar no pedido.</p>
</div>

<%= form_with url: order_imports_path, multipart: true, class: "panel p-5 grid gap-4 max-w-xl", data: { turbo: false } do %>
  <div>
    <label for="customer" class="mb-1 block font-bold">Cliente</label>
    <select id="customer" name="customer" class="field w-full">
      <% @customers.each do |customer| %>
        <option value="<%= customer.code %>" <%= "selected" if customer == @customer %>><%= customer.name %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label for="file" class="mb-1 block font-bold">Planilha</label>
    <input id="file" type="file" name="file" accept=".xlsx,.xls,.ods,.csv" required class="field w-full">
    <p class="muted mt-1 text-sm">Produtos nas linhas e os dias da semana nas colunas, com as datas no cabeçalho. Uma planilha por vez (processados e in natura vêm em arquivos separados).</p>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <%= button_tag type: "submit", class: "btn btn-primary" do %><%= icon :check %>Ler planilha<% end %>
    <%= link_to "Cancelar", orders_path(customer: @customer.code), class: "btn" %>
  </div>
<% end %>
