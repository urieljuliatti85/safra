<% content_for :title, "Chaves de API · Safra" %>
<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="page-title">Chaves de API</h1>
    <p class="page-sub">Acesso de outros sistemas aos dados de <%= current_company.name %>. A documentação está em <%= link_to "/api-docs", "/api-docs", class: "underline font-bold" %>.</p>
  </div>
  <%= link_to new_api_token_path, class: "btn btn-primary" do %><%= icon :plus %>Nova chave<% end %>
</div>

<section class="panel">
  <div class="overflow-x-auto">
    <table class="ops-table" style="min-width: 40rem; table-layout: auto">
      <thead><tr><th>Nome</th><th>Acesso</th><th>Situação</th><th>Último uso</th><th></th></tr></thead>
      <tbody>
        <% @tokens.each do |token| %>
          <tr class="<%= 'is-changed' if token.revoked? %>">
            <td class="name"><strong><%= token.name %></strong><br><span class="muted text-sm num"><%= token.token_prefix %>…</span></td>
            <td><%= token.scope_label %></td>
            <td><%= token.revoked? ? "Revogada em #{l(token.revoked_at, format: '%d/%m')}" : "Ativa" %></td>
            <td class="num"><%= token.last_used_at ? l(token.last_used_at, format: "%d/%m %H:%M") : "nunca usada" %></td>
            <td class="whitespace-nowrap">
              <% unless token.revoked? %>
                <%= button_to "Revogar", api_token_path(token), method: :delete, class: "btn", form: { class: "inline", data: { turbo_confirm: "Revogar a chave \"#{token.name}\"? Quem a usa deixa de acessar a API na hora, e não dá para desfazer." } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @tokens.empty? %>
          <tr><td colspan="5" class="muted p-6 text-center">Nenhuma chave ainda. Crie uma para liberar o acesso de outro sistema.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
